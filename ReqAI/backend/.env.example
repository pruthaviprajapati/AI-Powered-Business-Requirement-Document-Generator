# ── Application ───────────────────────────────────────────────────
APP_NAME=ReqAI
APP_VERSION=1.0.0
DEBUG=false

# ── Security (CHANGE IN PRODUCTION) ──────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./reqai.db

# ── CORS ──────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── File Upload ───────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100

# ── Whisper Speech Recognition (Phase 2) ─────────────────────────
# Model: tiny | base | small | medium | large-v2 | large-v3
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Set to language code (e.g. "en") or leave empty for auto-detect
WHISPER_LANGUAGE=en

# ── pyannote.audio Speaker Diarization (Phase 3) ─────────────────
# Get token: https://huggingface.co/settings/tokens
# Accept model terms at: https://huggingface.co/pyannote/speaker-diarization-3.1
PYANNOTE_HF_TOKEN=your_huggingface_token_here
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
# Set to 0 for auto-detect, or exact number expected
PYANNOTE_NUM_SPEAKERS=0
PYANNOTE_MAX_SPEAKERS=10

# ── spaCy NLP (Phase 4) ───────────────────────────────────────────
# Model: en_core_web_sm | en_core_web_md | en_core_web_lg
SPACY_MODEL=en_core_web_sm
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Future: HuggingFace (Phase 2) ────────────────────────────────
# HUGGINGFACE_TOKEN=your-hf-token

# ── Sentence Transformers Similarity (Phase 6) ───────────────────
# Model: all-MiniLM-L6-v2 (fast, strong semantic quality)
SIMILARITY_MODEL=all-MiniLM-L6-v2
# Pairs at or above this score are flagged POTENTIAL_DUPLICATE (0.0-1.0)
# Adjust based on your project's requirement corpus after initial testing
SIMILARITY_DUPLICATE_THRESHOLD=0.85
# Pairs above this but below duplicate threshold are flagged SIMILAR
SIMILARITY_REVIEW_THRESHOLD=0.65

# ── Groq LLM (Phase 7) ───────────────────────────────────────────
# Get your key at: https://console.groq.com
# NEVER put the real key here — use your local .env file only
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=4096
GROQ_TIMEOUT=60
GROQ_MAX_RETRIES=3
